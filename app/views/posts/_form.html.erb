<%= form_with(model: post) do |form| %>

  <% if post.errors.any? %>
    <div class="error-messages">
      <h2>入力内容にエラーがあります</h2>

      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :content, "つぶやき" %>
    <%= form.text_area :content %>
  </div>

  <%= form.submit %>

<% end %>